# systemd USER unit for the gambling client agent gateway.
#
# NOT INSTALLED and NOT ENABLED. To install it (no root needed):
#
#   mkdir -p ~/.config/systemd/user
#   cp /home/yeli/services/gambling-client-agent/systemd/gambling-agent-gateway.service \
#      ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now gambling-agent-gateway.service
#   systemctl --user status gambling-agent-gateway.service
#   curl -s http://127.0.0.1:8643/health
#
# Stop any gateway started by hand first (`pkill -f 'uvicorn app.main:app'`),
# or the unit fails to bind port 8642.
#
# BOOT BEHAVIOUR -- the part that is easy to get wrong:
# a user unit runs inside yeli's systemd session, which by default exists only
# while yeli is logged in. It starts at login and is torn down at logout, so
# "starts on boot" is NOT true until lingering is enabled:
#
#   sudo loginctl enable-linger yeli      # REQUIRES ROOT -- Lennon's call
#
# That has not been run. Until it is, the gateway comes up when Lennon logs in
# and stops when the last session ends -- and the Open WebUI container (which
# has restart: unless-stopped and so does come back on boot) will be up with a
# dead gateway behind it. Chats then fail with "Could not reach the gambling
# gateway" until the session exists. Deliberate: enabling lingering means a
# process holding NOPASSWD-root privileges runs unattended from boot, which is
# a decision for the owner of that privilege, not for an agent.
#
# WHY NOT A SYSTEM UNIT: a system unit needs root to install and would run the
# gateway outside yeli's session with no owner attached to it. docs/RELOCATION.md
# sketches one for the /srv relocation that has not happened.

[Unit]
Description=Gambling client agent gateway (loopback only, 127.0.0.1:8643)
Documentation=file:///home/yeli/services/gambling-client-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/yeli/services/gambling-client-agent
Environment=GAMBLING_AGENT_HOME=/home/yeli/services/gambling-client-agent
# run_gateway.sh sources .env (mode 600) itself and execs uvicorn bound to
# 127.0.0.1, so the shared secret never appears in this unit, in `systemctl
# show`, or in the journal. Do NOT add EnvironmentFile=.env here: it would put
# the secret and the client password into systemd's exported environment.
ExecStart=/home/yeli/services/gambling-client-agent/scripts/run_gateway.sh
Restart=on-failure
RestartSec=5
# A job can run for up to 30 minutes (codex.timeout_seconds); do not let a
# stop signal cut a commit in half.
TimeoutStopSec=60
StandardOutput=append:/home/yeli/services/gambling-client-agent/logs/gateway.log
StandardError=append:/home/yeli/services/gambling-client-agent/logs/gateway.log

# DELIBERATELY NOT HARDENED FURTHER. Each of the obvious directives breaks
# something this service needs, and an untested sandbox that silently disables
# containment is worse than none:
#   ProtectHome=yes        hides ~/.codex (Codex auth) -- see docs/RELOCATION.md
#   NoNewPrivileges=yes    inherited by every child, including bwrap and codex;
#                          untested against the jail, which is the one thing
#                          that must not be weakened by accident
#   RestrictNamespaces=    the jail IS an unprivileged user namespace
#   PrivateTmp=yes         the jail already gives codex a private tmpfs
# Containment for the agent is bubblewrap's job (gateway/app/jail.py), not
# systemd's. The gateway process itself is unjailed by design and by record --
# see the README risk register, item 2.

[Install]
WantedBy=default.target
