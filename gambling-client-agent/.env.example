# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate a secret with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
GAMBLING_GATEWAY_SECRET=replace-me-with-a-long-random-string

# Open WebUI user granted read-only access to the Gamble model. This is an
# account identifier and must be configured locally, not committed with a real value.
GAMBLING_ALLOWED_USER_ID=replace-me-with-openwebui-user-id

# The gateway now uses GitHub Copilot CLI by default. Supply a fine-grained
# GitHub token with Copilot Requests permission for the jailed worker, or leave
# this unset until the maintainer has arranged another supported credential.
# COPILOT_GITHUB_TOKEN=github_pat_...

# Optional overrides. All have working defaults in gateway/config.yaml.
# GAMBLING_AGENT_HOME=/srv/gambling-client-agent
# GAMBLING_GATEWAY_HOST=127.0.0.1
# GAMBLING_GATEWAY_PORT=8642
# GAMBLING_SOURCE_REPO=/home/yeli/shiny/gambling
# GAMBLING_MEMORY_INDEX=/home/yeli/obsidian/AgentSystem/agent-memory/projects/gambling/MEMORY_INDEX.md
# GAMBLING_AGENT_PROVIDER=copilot
# GAMBLING_COPILOT_BIN=copilot
# GAMBLING_COPILOT_PATH=/home/yeli/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# GAMBLING_CODEX_BIN=codex
# GAMBLING_CODEX_PATH=/home/yeli/.local/bin:/usr/local/bin:/usr/bin:/bin
